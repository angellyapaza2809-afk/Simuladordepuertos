# Supabase — variables públicas, seguras para el cliente (frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NUNCA poner la service_role key aquí ni commitearla.
# La service_role key solo se usa en scripts de servidor/backoffice,
# fuera del repositorio del frontend, vía variable de entorno del
# entorno de ejecución (CI/CD, servidor), no en .env del cliente.
